<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SharedTravel.ViewModels"
             xmlns:models="clr-namespace:SharedTravel.Models"
             x:Class="SharedTravel.Pages.MainPage"
             x:DataType="viewModels:MainViewModel">
    <Grid
        RowDefinitions="Auto, *, Auto"
        Padding="10"
    >
        <!--  Заголовок  -->
        <Label
            Grid.Row="0"
            Text="My trips"
            FontSize="{StaticResource HeaderSize}"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            Padding="0,0,0,10"
        />
        <!--  Список поездок  -->
        <CollectionView
            ItemsSource="{Binding Trips}"
            Grid.Row="1"
        >
            <!-- Расстояние между карточками -->
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            
            <CollectionView.ItemTemplate>
                <DataTemplate
                   x:DataType="models:Trip">
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout 
                            Padding="0">
                            <Label
                                Text="{Binding Name}"
                                FontAttributes="Bold"
                                FontSize="18"
                                Padding="0,0,0,5"
                            />
                            <Label>
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0:dd.MM.yyyy} - {1:dd.MM.yyyy}">
                                        <Binding Path="StartDate"></Binding>
                                        <Binding Path="EndDate"></Binding>
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Label>
                                <Label.Text>
                                    <MultiBinding StringFormat="{}Country: {0} - Currency: {1}">
                                        <Binding Path="CountryName"></Binding>
                                        <Binding Path="CurrencyCode"></Binding>
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Label Text="{Binding CitiesNames, StringFormat='Cities: {0}'}"/>
                            <Label Text="{Binding ParticipantsNames, StringFormat='Participants: {0}'}"/>
                            <Label
                                Text="{Binding PlannedBudget, StringFormat='Planned budget: {0}'}"
                            />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label 
                   Text="No trips yet..." 
                    HorizontalOptions="Center"
                />
            </CollectionView.EmptyView>
        </CollectionView>
        <!--  Кнопка  -->
        <Button
            Grid.Row="2"
            Text="Add new trip"
            BackgroundColor="LightBlue"
            Command="{Binding GoToAddTripPageCommand}"
        />
    </Grid>
</ContentPage>
