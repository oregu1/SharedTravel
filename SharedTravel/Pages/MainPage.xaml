<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SharedTravel.ViewModels"
             xmlns:models="clr-namespace:SharedTravel.Models"
             x:Class="SharedTravel.Pages.MainPage"
             x:DataType="viewModels:MainViewModel">
    <Grid
        RowDefinitions="Auto, *, Auto"
        Padding="10"
    >
        <!--  Заголовок  -->
        <Label
            Grid.Row="0"
            Text="Мои путешествия"
            FontSize="{StaticResource HeaderSize}"
            FontAttributes="Bold"
            HorizontalOptions="Center"
        />
        <!--  Список поездок  -->
        <CollectionView
            ItemsSource="{Binding Trips}"
            Grid.Row="1"
        >
            <CollectionView.ItemTemplate>
                <DataTemplate
                   x:DataType="models:Trip">
                    <VerticalStackLayout 
                       Padding="0, 10">
                        <Label
                            Text="{Binding Name}"
                            FontAttributes="Bold"
                        />
                        <Label
                            Text="{Binding StartDate, StringFormat='Начало: {0:dd.MM.yyyy}'}"
                        />
                        <Label
                            Text="{Binding EndDate, StringFormat='Конец: {0:dd.MM.yyyy}'}"
                        />
                        <Label
                            Text="{Binding Country, StringFormat='Страна: {0}'}"
                        />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label 
                   Text="Вы еще никуда не ездили..." 
                    HorizontalOptions="Center"
                />
            </CollectionView.EmptyView>
        </CollectionView>
        <!--  Кнопка  -->
        <Button
            Grid.Row="2"
            Text="Добавить поездку"
            BackgroundColor="LightBlue"
            Command="{Binding GoToAddTripPageCommand}"
        />
    </Grid>
</ContentPage>
