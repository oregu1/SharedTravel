<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SharedTravel.ViewModels"
             xmlns:models="clr-namespace:SharedTravel.Models"
             x:Class="SharedTravel.Pages.AddTripPage"
             x:DataType="viewModels:AddTripViewModel">
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">
                
                <!-- TRIP NAME -->
                <Label Text="Trip title"/>
                <Entry Text="{Binding TripTitle}" Placeholder="Enter trip title"/>
                
                <!-- TRIP DATES -->
                <Label Text="Trip dates from/to"/>
                <DatePicker Date="{Binding TripStartDate}" />
                <DatePicker Date="{Binding TripEndDate}" />
                
                <!-- COUNTRY -->
                <Picker
                    Title="Country"
                    ItemsSource="{Binding Countries}"
                    ItemDisplayBinding="{Binding Name, x:DataType=models:CountryOption}"
                    SelectedItem="{Binding SelectedCountry}"
                />
                
                <!-- CURRENCY -->
                <Picker
                    Title="Currency"
                    ItemsSource="{Binding Currencies}"
                    SelectedItem="{Binding SelectedCurrency}"
                />
                
                <!-- PLANNED BUDGET -->
                <Label Text="Planned budget"/>
                <Entry Text="{Binding TripPlannedBudget}" Placeholder="Planned budget amount" Keyboard="Numeric"/>
                
                <!-- CITIES -->
                <Label Text="Cities"/>
                <Entry Text="{Binding NewCityName}" Placeholder="Введите название города"/>
                <Button
                    Text="Add city"
                    Command="{Binding AddCityCommand}"
                />
                
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Cities}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate
                            x:DataType="models:City">
                            <Label Text="{Binding Name}"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                
                <!-- PARTICIPANTS -->
                <Label Text="Participants"/>
                <Entry Text="{Binding NewParticipant}" Placeholder="Participant name"/>
                <Button
                    Text="Add participant"
                    Command="{Binding AddParticipantCommand}"
                />
                
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Participants}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate
                            x:DataType="models:Participant">
                            <Label Text="{Binding Name}"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                
                <!-- ADD TRIP BUTTON -->
                <Button
                    Text="Add trip"
                    Command="{Binding SaveNewTripToDbCommand}"
                />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>