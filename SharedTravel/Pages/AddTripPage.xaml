<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SharedTravel.ViewModels"
             xmlns:models="clr-namespace:SharedTravel.Models"
             x:Class="SharedTravel.Pages.AddTripPage"
             x:DataType="viewModels:AddTripViewModel">
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="Название поездки"/>
                <Entry Text="{Binding TripTitle}" Placeholder="Введите название поездки"/>
                
                <Label Text="Дата поездки с/по"/>
                <DatePicker Date="{Binding TripStartDate}" />
                <DatePicker Date="{Binding TripEndDate}" />
                
                <Picker
                    Title="Страна поездки"
                    ItemsSource="{Binding Countries}"
                    ItemDisplayBinding="{Binding Name, x:DataType=models:CountryOption}"
                    SelectedItem="{Binding SelectedCountry}"
                />
                
                <Picker
                    Title="Валюта расчетов в поездке"
                    ItemsSource="{Binding Currencies}"
                    SelectedItem="{Binding SelectedCurrency}"
                />
                
                <Label Text="Плановая сумма бюджета"/>
                <Entry Text="{Binding TripPlannedBudget}" Placeholder="Какую сумму хотите взять для поездки?" Keyboard="Numeric"/>
                <Button
                    Text="Сохранить"
                    Command="{Binding SaveNewTripToDbCommand}"
                    />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>