<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SharedTravel.ViewModels"
    x:Class="SharedTravel.Pages.AddTripPage"
    x:DataType="viewModels:AddTripViewModel"
    Title="New trip">

    <VerticalStackLayout Padding="16" Spacing="12">

        <Label Text="Trip name" />

        <Entry
            Text="{Binding Trip.Name, Mode=TwoWay}"
            Placeholder="For example, summer in Italy" />

    </VerticalStackLayout>

</ContentPage>