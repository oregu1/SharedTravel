<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SharedTravel.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:SharedTravel.Pages"
    Title="SharedTravel">

    <TabBar>
        <ShellContent
            Title="Главная"
            ContentTemplate="{DataTemplate pages:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Расчеты"
            ContentTemplate="{DataTemplate pages:SettlementsPage}"
            Route="SettlementsPage" />
        <ShellContent
            Title="Профиль"
            ContentTemplate="{DataTemplate pages:ProfilePage}"
            Route="ProfilePage" />
    </TabBar>
</Shell>
